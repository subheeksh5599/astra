# ASTRA configuration. Copy to .env, fill in, never commit .env.
# Every script reads this file, or the path in $ASTRA_ENV, or the process
# environment. Nothing here reads a path outside the project.

# --- the execution layer ----------------------------------------------------
# Direct-execution key for the service that signs and broadcasts the
# destination-side call. Supply it through the environment; it is never read
# from a file this project does not own and never reaches the browser.
KH_API_KEY=

# --- the payer side (used only by scripts/astra_open_transfer.py) -----------
# A wallet this machine holds the key for. Creating a transfer is the payer's
# own transaction; in the browser, the payer's wallet signs instead.
BUYER=
BUYER_KEY=

# --- deployment choice ------------------------------------------------------
# Two deployments of the protocol are live on these testnets at once. The later
# one (v2) is the default: it takes a fee cap and a finality threshold, so a
# transfer can be attested as soon as the source block is confirmed.
ASTRA_DEPLOYMENT=v2

# Which attestation path answers. Defaults to the deployment above.
# ATTESTATION_VERSION=v2

# --- endpoints --------------------------------------------------------------
# One endpoint per domain. A single shared RPC_URL is deliberately not supported:
# it silently makes every domain read the same chain.
RPC_DOMAIN_6=https://sepolia.base.org
RPC_DOMAIN_0=https://ethereum-sepolia-rpc.publicnode.com

# Attestation service.
ATTESTATION_BASE=https://iris-api-sandbox.circle.com

# --- optional overrides -----------------------------------------------------
# The protocol's contract addresses are public constants with defaults in
# astra/config.py. Override them here if you point this rail at another
# deployment of the same protocol.
# TRANSMITTER_DOMAIN_6=
# TRANSMITTER_DOMAIN_0=
# MESSENGER_DOMAIN_6=
# MESSENGER_DOMAIN_0=

# How far back discovery reads the source chain's log stream, in blocks.
ASTRA_SCAN_BLOCKS=4000

# Shown on the control surface when set.
# FAUCET_URL=

# --- the HTTP surface -------------------------------------------------------
# Binds to localhost by default. It executes with the executor's key, so do not
# expose it without authentication in front of it.
HOST=127.0.0.1
PORT=8099

# Set to any value to log every HTTP request.
# ASTRA_HTTP_LOG=1
